{
  "name": "ubiqx-launch-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ubiqX AI — launch video (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts --port 1460",
    "compositions": "remotion compositions src/index.ts",
    "still": "remotion still src/index.ts",
    "stills": "node tools/stills.mjs",
    "bench": "node tools/bench.mjs",
    "render": "remotion render src/index.ts Launch out/launch.mp4",
    "render:draft": "remotion render src/index.ts Launch out/launch-draft.mp4 --scale=0.5 --crf=26 --jpeg-quality=80 --x264-preset=veryfast --props='{\"draft\":true}'",
    "render:primitives": "remotion render src/index.ts Primitives out/primitives.mp4",
    "typecheck": "tsc --noEmit",
    "grain": "python3 tools/make-grain.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/media-utils": "4.0.529",
    "@remotion/motion-blur": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/shapes": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "lucide-react": "1.48.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
