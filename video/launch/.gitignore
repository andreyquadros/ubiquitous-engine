node_modules/
out/
.remotion/
build/
*.log

# UBI frame sequences are ~220 MB of PNGs and fully regenerable:
#   node tools/ubi-render/render.mjs   (then verify.py --update-manifest and optimize.py)
# The manifest and the stills stay tracked.
public/ubi/*/
!public/ubi/stills/

# Music stems are pre-master copies (~50 MB) regenerated by tools/music/compose.py;
# the mastered music.wav is the file the film uses.
public/audio/music/stems/
