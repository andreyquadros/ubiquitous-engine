{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: the window and plugin permissions, and the three commands of the shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "opener:default",
    "notification:default",
    "autostart:default",
    "log:default",
    "updater:default",
    "process:allow-restart",
    "allow-shield",
    "allow-shield-host",
    "allow-quit-app"
  ]
}
