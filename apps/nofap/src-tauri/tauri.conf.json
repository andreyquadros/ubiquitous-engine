{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoFap",
  "mainBinaryName": "ubiqx-shield",
  "version": "0.1.0",
  "identifier": "ai.ubiqx.shield",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../../desktop build:nofap",
    "frontendDist": "../../desktop/dist-nofap"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoFap",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
