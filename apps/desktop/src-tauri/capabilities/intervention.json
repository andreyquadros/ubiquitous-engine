{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "intervention",
  "description": "Capability for UBI's intervention window: it reads the settings (the language) and the interventions, closes itself and can be dragged",
  "windows": ["intervention"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-list-interventions"
  ]
}
